EXE = 2D_EWAPE
SRC = main.f90
OUT_DIR = out
#all: compil simu

compil :
	#Compilation des modules, l'ordre est important
	$(FC) -c $(FCFLAGS) $(chemin_modules)/kind_mod.f90
	$(FC) -c $(FCFLAGS) $(chemin_modules)/constants.f90
	$(FC) -c $(FCFLAGS) $(chemin_modules)/utils_module.f90
	$(FC) -c $(FCFLAGS) $(chemin_modules)/interp1D_mod.f90
	$(FC) -c $(FCFLAGS) $(chemin_modules)/interp_plane_mod.f90
	$(FC) -c $(FCFLAGS) $(chemin_modules)/bspline_sub_module.f90
	$(FC) -c $(FCFLAGS) $(chemin_modules)/interp_spline_mod.f90
	$(FC) -c $(FCFLAGS) $(chemin_modules)/input_params.f90
	$(FC) -c $(FCFLAGS) $(chemin_modules)/atm_abs_module.f90
	$(FC) -c $(FCFLAGS) -I$(INC) $(chemin_modules)/mesh_module.f90
	$(FC) -c $(FCFLAGS) -I$(INC) $(chemin_modules)/flow_module.f90
	$(FC) -c $(FCFLAGS) -I$(INC) $(chemin_modules)/write_outputs.f90
	$(FC) -c $(FCFLAGS) $(chemin_modules)/iim_utils.f90
	$(FC) -c $(FCFLAGS) $(chemin_modules)/splitstep_utils.f90
	$(FC) -c $(FCFLAGS) $(chemin_modules)/trisolve_mod.f90
	$(FC) -c $(FCFLAGS) $(chemin_modules)/splitstep_pe_wavy.f90
	$(FC) -c $(FCFLAGS) -I$(INC) $(SRC)

	#Compilation du programme
	# -I donne un repertoire ou chercher les .mod
#	$(FC) $(SRC)  -I$(chemin_dossier_src_comp) $(chemin_dossier_src_comp)/*.o -o  $(EXE) $(FCFLAGS)
	$(FC) $(FCFLAGS) -L/$(LIB) ./*.o -o $(EXE) -lhdf5 -lhdf5_fortran -llapack -lblas

clean :

	rm *.o
	rm *.mod
	rm 2D_EWAPE
